#include <QApplication>
#include <QWidget>
#include <QVBoxLayout>
#include <QLabel>
#include <QLineEdit>
#include <QSpinBox>
#include <QPushButton>
#include <QPlainTextEdit>
#include <QFile>
#include <QProcess>
#include <QString>
#include <QTextStream>
#include <QDebug>

int mmToDots(double mm)
{
    return (mm * 203) / 25.4;
}

QString generateZPL(
    QString product,
    QString barcode,
    int rows
)
{
    QString zpl = "^XA\n";

    int columns = 3;

    int labelWidth = mmToDots(30);
    int gapX = mmToDots(2);

    for (int row = 0; row < rows; row++) {

        for (int col = 0; col < columns; col++) {

            int offsetX = (labelWidth + gapX) * col;
            int offsetY = row * 200;

            zpl += QString("^FO%1,%2")
                .arg(offsetX + 20)
                .arg(offsetY + 20);

            zpl += "^A0N,30,30";
            zpl += QString("^FD%1^FS\n").arg(product);

            zpl += QString("^FO%1,%2")
                .arg(offsetX + 20)
                .arg(offsetY + 70);

            zpl += "^BY2";
            zpl += "^BCN,60,Y,N,N";
            zpl += QString("^FD%1^FS\n").arg(barcode);
        }
    }

    zpl += "^XZ";

    return zpl;
}

int main(int argc, char *argv[])
{
    QApplication app(argc, argv);

    QWidget window;
    window.setWindowTitle("523LabelApp");
    window.resize(700, 600);

    auto *layout = new QVBoxLayout();

    auto *productLabel = new QLabel("Product Name");
    auto *productInput = new QLineEdit();

    auto *barcodeLabel = new QLabel("Barcode");
    auto *barcodeInput = new QLineEdit();

    auto *rowsLabel = new QLabel("Rows");
    auto *rowsInput = new QSpinBox();

    rowsInput->setMinimum(1);
    rowsInput->setValue(1);

    auto *generateButton = new QPushButton("Generate ZPL");
    auto *printButton = new QPushButton("Print");

    auto *preview = new QPlainTextEdit();

    layout->addWidget(productLabel);
    layout->addWidget(productInput);

    layout->addWidget(barcodeLabel);
    layout->addWidget(barcodeInput);

    layout->addWidget(rowsLabel);
    layout->addWidget(rowsInput);

    layout->addWidget(generateButton);
    layout->addWidget(printButton);

    layout->addWidget(preview);

    QObject::connect(generateButton, &QPushButton::clicked,
        [&]() {

        QString zpl = generateZPL(
            productInput->text(),
            barcodeInput->text(),
            rowsInput->value()
        );

        preview->setPlainText(zpl);
    });

    QObject::connect(printButton, &QPushButton::clicked,
        [&]() {

        QString zpl = preview->toPlainText();

        QFile file("/tmp/label.zpl");

        if (file.open(QIODevice::WriteOnly | QIODevice::Text)) {

            QTextStream out(&file);
            out << zpl;

            file.close();
        }

        QString command =
            "cat /tmp/label.zpl | lp -d ZTC-ZD220-203dpi-ZPL -o raw";

        QProcess process;

        process.start("bash", QStringList() << "-c" << command);

        process.waitForFinished();

        qDebug() << process.readAllStandardOutput();
        qDebug() << process.readAllStandardError();
    });

    window.setLayout(layout);

    window.show();

    return app.exec();
}
